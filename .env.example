# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- Mozilla Otari AI gateway (preferred) ------------------------------------
# When OTARI_API_KEY is set, every server-side model call goes through Otari
# (https://api.otari.ai, OpenAI-compatible) with open-weight models per role.
# NVIDIA / OpenRouter below stay as optional last-resort fallbacks.
# OTARI_API_KEY=otari-...                                  # use a service key for per-user budgets
# OTARI_BASE_URL=https://api.otari.ai/api/v1
# Ordered model list (or an Otari routing-policy name) per role; next entry is tried on error.
# OTARI_MODELS_EXTRACT=alibaba/qwen3-30b-a3b-instruct-2507,nvidia/nemotron-3-nano-30b-a3b,openai/gpt-oss-20b
# OTARI_MODELS_IDEAS=alibaba/qwen3-235b-a22b-instruct-2507,deepseek/deepseek-v4-flash,meta/llama-3.3-70b-instruct
# OTARI_MODELS_JUDGE=deepseek/deepseek-v4-flash,alibaba/qwen3-235b-a22b-instruct-2507
# OTARI_MODELS_BUILD=alibaba/qwen3-coder-480b-a35b-instruct,alibaba/qwen3-coder-30b-a3b-instruct
# OTARI_MODELS_GUARD=alibaba/qwen3guard-gen-8b,meta/llama-guard-4-12b
# OTARI_MODELS_RESEARCH=alibaba/qwen3-235b-a22b-instruct-2507,moonshotai/kimi-k2.6
# OTARI_MODELS_CHAT=alibaba/qwen3-235b-a22b-instruct-2507         # Pilot chat (AGENT_ENGINE=otari)
# OTARI_END_USER=off                 # stop sending the signed-in user as `user` (per-user budgets)
# OTARI_GUARDRAILS=prompt-injection:block   # request-level guardrails (needs a guardrails service on the gateway)
# OTARI_GUARD=off                    # skip the guard-model screen of imported page text
# OTARI_MCP_URL=https://mcp.deepwiki.com/mcp  # managed MCP for idea research; "off" disables
# OTARI_MCP_TOKEN= OTARI_MCP_NAME= OTARI_MCP_TOOLS=ask_question,read_wiki_structure
# OTARI_DISABLE_TOOLS=otari_web_fetch       # force the local fetch fallback (testing)
# AGENT_ENGINE=otari                 # run Pilot chat through Otari

# --- HackPilot LLM providers -------------------------------------------------
# Fast in-action AI tries NVIDIA first and falls back to OpenRouter on errors.
# Build it and Pilot chat default to Claude Haiku 5.5 on OpenRouter when configured.
# OPENROUTER_API_KEY is required for Build it; keys may also be in the secret store.
# Build requests omit max_tokens; upstream limits and request timeouts still apply.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b        # fast structured calls
# NVIDIA_THINKING=1                                          # re-enable Nemotron reasoning (slower)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_BUILD_MODEL=anthropic/claude-haiku-5.5         # optional build model override
# HACKPILOT_DISABLE_PROVIDERS=nvidia                         # force fast-call fallback (testing)
# HACKPILOT_BUILD_DIR=./data/builds                          # where generated apps are built
# Fusion ZIP verification uses a local Docker daemon and a pre-pulled node:22-bookworm-slim image.
# For a development session, AGENT_NATIVE_FUSION_VERIFIER can point to an operator-managed executable.
# It receives <staged source directory> and one operation (install, typecheck, build, smoke, cleanup).

# Agent chat on NVIDIA: the framework refuses env keys for a custom OPENAI_BASE_URL,
# so save the NVIDIA key + base URL https://integrate.api.nvidia.com/v1 as an
# OpenAI-compatible key in Settings > AI engine instead of setting env vars.
