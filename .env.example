# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- HackPilot LLM providers -------------------------------------------------
# In-action AI (import extraction, idea generation/scoring, "Build it") tries
# NVIDIA build first and falls back to OpenRouter on error / 404 / 410 / 429 /
# timeout. Keys can also live in the framework secret store.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b        # fast structured calls
# NVIDIA_BUILD_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b  # "Build it" code generation
# NVIDIA_THINKING=1                                          # re-enable Nemotron reasoning (slower)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# OPENROUTER_BUILD_MODEL=openai/gpt-6-luna                   # paid, ~$0.005 per app
# HACKPILOT_DISABLE_PROVIDERS=nvidia                         # force the fallback (testing)
# HACKPILOT_BUILD_DIR=./data/builds                          # where generated apps are built

# In-app agent chat on NVIDIA via the framework's OpenAI-compatible engine.
# AGENT_ENGINE=ai-sdk:openai
# AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-...   # the NVIDIA key; remove these four lines to use OpenRouter for chat
